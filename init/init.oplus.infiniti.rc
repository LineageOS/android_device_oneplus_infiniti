# Display
on property:persist.sys.sf.native_mode=301
    write /sys/kernel/oplus_display/seed 101

on property:persist.sys.sf.native_mode=303
    write /sys/kernel/oplus_display/seed 102

on property:persist.sys.sf.native_mode=307
    write /sys/kernel/oplus_display/seed 100
